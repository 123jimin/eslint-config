{
  "name": "@jiminp/eslint-config",
  "description": "JiminP's personal ESLint configuration.",
  "version": "1.3.6",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./ts": {
      "types": "./src/index.typescript.d.ts",
      "default": "./src/index.typescript.js"
    },
    "./js": {
      "types": "./src/index.javascript.d.ts",
      "default": "./src/index.javascript.js"
    },
    "./strict": {
      "types": "./src/strict.d.ts",
      "default": "./src/strict.js"
    },
    "./style": {
      "types": "./src/style.d.ts",
      "default": "./src/style.js"
    },
    "./imports": {
      "types": "./src/imports.d.ts",
      "default": "./src/imports.js"
    },
    "./package.json": "./package.json"
  },
  "author": "Jimin Park (https://github.com/123jimin/)",
  "homepage": "https://github.com/123jimin/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/123jimin/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/123jimin/eslint-config/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "license": "Unlicense",
  "engines": {
    "node": ">=18.18.0"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.6.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "typescript-eslint": "^8.62.1"
  },
  "peerDependenciesMeta": {
    "typescript-eslint": {
      "optional": true
    },
    "@stylistic/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-simple-import-sort": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.6.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "typescript-eslint": "^8.62.1"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}