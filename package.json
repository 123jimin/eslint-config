{
  "name": "@jiminp/eslint-config",
  "description": "JiminP's personal ESLint configuration.",
  "version": "1.3.7",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./ts": {
      "types": "./src/index.typescript.d.ts",
      "default": "./src/index.typescript.js"
    },
    "./js": {
      "types": "./src/index.javascript.d.ts",
      "default": "./src/index.javascript.js"
    },
    "./strict": {
      "types": "./src/strict.d.ts",
      "default": "./src/strict.js"
    },
    "./style": {
      "types": "./src/style.d.ts",
      "default": "./src/style.js"
    },
    "./imports": {
      "types": "./src/imports.d.ts",
      "default": "./src/imports.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node test/smoke.js"
  },
  "author": "Jimin Park (https://github.com/123jimin/)",
  "homepage": "https://github.com/123jimin/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/123jimin/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/123jimin/eslint-config/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "license": "Unlicense",
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.5.0",
    "eslint": "^10.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0 || ^14.0.0",
    "typescript-eslint": "^8.56.0"
  },
  "peerDependenciesMeta": {
    "typescript-eslint": {
      "optional": true
    },
    "@stylistic/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-simple-import-sort": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.7.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d"
}